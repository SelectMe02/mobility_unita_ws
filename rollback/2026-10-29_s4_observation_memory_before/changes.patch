+
+class S4IdentityMemoryTests(unittest.TestCase):
+    def planner(self):
+        p = RouteAvoidance([(0., 0.), (400., 0.)])
+        p.set_static_pass_zone(98., 116., 140., 147., -3.2)
+        return p
+
+    def box(self, identity, s=129., d=0., r=.8, l=.7):
+        return dict(id=identity, s=s, d=d, r=r, l=l,
+                    moving=False, v_s=0., v_d=0.)
+
+    def observe(self, p, boxes, stamp):
+        p.observation_time = stamp
+        return p._retain_static_blocks(boxes, 110.)
+
+    def test_reidentified_box_replaces_memory_and_survives_dropout(self):
+        p = self.planner()
+        self.observe(p, [self.box(1)], 1.)
+        for i in range(15):
+            result = self.observe(p, [self.box(2)], 1.1+i*.1)
+        self.assertEqual([h['id'] for h in p.static_memory], [2])
+        self.assertEqual(len(result), 1)
+        self.assertEqual([h['id'] for h in self.observe(p, [], 2.6)], [2])
+
+    def test_partial_match_requires_visible_empty_remainder(self):
+        for visible in (False, True):
+            p = self.planner()
+            p.static_clearance_observer = lambda h: visible
+            self.observe(p, [self.box(1, r=1.2)], 1.)
+            for i in range(15):
+                self.observe(p, [self.box(2, r=.7)], 1.1+i*.1)
+            self.assertEqual(any(h['id'] == 1 for h in p.static_memory), not visible)
+
+    def test_different_nearby_obstacle_is_not_identity_match(self):
+        p = self.planner()
+        self.observe(p, [self.box(1)], 1.)
+        for i in range(15):
+            self.observe(p, [self.box(2, s=132.)], 1.1+i*.1)
+        self.assertEqual({h['id'] for h in p.static_memory}, {1, 2})
+
+    def test_simultaneously_visible_ids_are_not_merged(self):
+        p = self.planner()
+        for i in range(15):
+            self.observe(p, [self.box(1), self.box(2, d=.3)], 1.+i*.1)
+        self.assertEqual({h['id'] for h in p.static_memory}, {1, 2})
+
+    def test_repeated_stamp_cannot_release_old_id(self):
+        p = self.planner()
+        self.observe(p, [self.box(1)], 1.)
+        for i in range(4):
+            self.observe(p, [self.box(2)], 1.1+i*.1)
+        for i in range(20):
+            self.observe(p, [self.box(2)], 1.4)
+        self.assertIn(1, [h['id'] for h in p.static_memory])
+
+    def test_unobserved_memory_is_not_expired_by_time(self):
+        p = self.planner()
+        self.observe(p, [self.box(1)], 1.)
+        self.observe(p, [], 100.)
+        self.assertEqual([h['id'] for h in p.static_memory], [1])
