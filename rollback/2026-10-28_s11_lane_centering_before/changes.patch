+        p = planner(r3_end=160)
+        p.sectors = [10]*len(p.sectors)
+        p.highway_sectors = (10,)
+        p.plan(60, (60., 7.2), 15., [], desired_speed_mps=f.CRUISE)
+        self.assertEqual(p.transition['target'], 2)
+        self.assertNotIn('s11_forward_only', p.transition)
+
