+"""Admission considers rear traffic; an approved S11 maneuver never reverses."""
+import unittest
+import test_highway_planner as f
+
+
+def planner(**kwargs):
+    return f.planner(s11_commit_changes=True, highway_keep_lane_priority=True, **kwargs)
+
+
+class CommittedChangeTests(unittest.TestCase):
+    def step(self, p, stamp, obstacles=(), index=60, y=7.2, speed=15.):
+        return p.plan(index, (float(index), y), speed, list(obstacles),
+                      desired_speed_mps=f.CRUISE, observation_stamp=stamp)
+
+    def approved(self):
+        p = planner(r3_end=180)
+        for stamp in (1., 1.2, 1.4):
+            self.step(p, stamp)
+        self.assertIsNotNone(p.transition)
+        self.assertTrue(p.transition['committed'])
+        return p
+
+    def test_default_enables_s11_policy(self):
+        p = f.core.LocalAvoidancePlanner([(0., 0.), (100., 0.)], [11, 11], {})
+        self.assertTrue(p.s11_commit_changes)
+
+    def test_moving_leader_only_generates_same_lane_following(self):
+        for speed in (30./3.6, 12., 20.):
+            for lane in (1, 2, 3):
+                p = planner()
+                for stamp in (1., 1.2, 1.4, 3., 5.):
+                    d = self.step(p, stamp, [f.car(105., lane, speed)], y=f.LANE_Y[lane], speed=25.)
+                    self.assertIsNone(p.transition)
+                    self.assertEqual(d.reason, 'follow_leader_keep_lane')
+                    self.assertLess(d.speed_cap_kmh, f.CRUISE*3.6)
+                    self.assertTrue(all(abs(y-f.LANE_Y[lane]) < .01 for _,y in d.path))
+
+    def test_repeated_scan_cannot_approve_and_gap_must_persist(self):
+        p = planner(r3_end=180)
+        for stamp in (1., 1., 1., 1.2):
+            self.step(p, stamp)
+            self.assertIsNone(p.transition)
+        self.step(p, 1.4)
+        self.assertTrue(p.transition['committed'])
+
+    def test_gap_interruption_and_scan_dropout_reset_confirmation(self):
+        for interruption in ('obstacle', 'dropout'):
+            p = planner(r3_end=180)
+            self.step(p, 1.)
+            self.step(p, 1.2)
+            if interruption == 'obstacle':
+                self.step(p, 1.3, [f.car(60., 2, 15.)])
+            self.step(p, 2.)
+            self.step(p, 2.2)
+            self.assertIsNone(p.transition)
+            self.step(p, 2.4)
+            self.assertIsNotNone(p.transition)
+
+    def test_unknown_or_predicted_rear_car_is_not_assumed_stationary(self):
+        for kind in ('unconfirmed', 'unreliable', 'predicted'):
+            p = planner(r3_end=180)
+            car = f.car(45., 2, 0.)
+            if kind == 'unconfirmed': car.confirmed = False
+            if kind == 'unreliable': car.velocity_reliable = False
+            if kind == 'predicted': car.predicted = True
+            for stamp in (1., 1.2, 1.4, 1.6):
+                d = self.step(p, stamp, [car])
+                self.assertIsNone(p.transition)
+            self.assertEqual(d.reason, 'target_rear_unreliable')
+
+    def test_rear_check_covers_full_merge_and_ego_deceleration(self):
+        p = planner()
+        available = {1:(60., 0.), 2:(60., 3.6)}
+        transition = dict(length=80., speed_cap_kmh=90.)
+        # Rear is 40 m away but will catch ego while ego slows for a leader.
+        rear = f.car(17., 2, 24.)
+        lead = (80., f.car(140., 2, 12.), 12.)
+        self.assertEqual(p._s11_rear_admission(60, (60., 0.), available, 2,
+                         [rear], 25., transition, lead), 'target_rear_gap')
+        rear.vx = 10.
+        self.assertEqual(p._s11_rear_admission(60, (60., 0.), available, 2,
+                         [rear], 25., transition, lead), '')
+
+    def test_safe_rear_car_allows_merge(self):
+        p = planner(r3_end=180)
+        for stamp in (1., 1.2, 1.4):
+            self.step(p, stamp, [f.car(30., 2, 10.)])
+        self.assertTrue(p.transition['committed'])
+
+    def test_new_side_front_or_rear_threat_does_not_cancel(self):
+        for obstacles in ([f.car(64., 2, 0.)], [f.car(85., 2, 0.)], [f.car(50., 2, 30.)]):
+            p = self.approved()
+            original = dict(p.transition)
+            for stamp in (1.5, 1.6, 1.7, 1.8, 2.):
+                d = self.step(p, stamp, obstacles)
+                self.assertEqual(p.transition, original)
+                self.assertEqual(d.reason, 'committed_lane_change')
+                self.assertNotEqual(d.state, 'CANCELLING')
+                self.assertTrue(d.path)
+
+    def test_completion_requires_lateral_arrival_not_just_progress(self):
+        p = self.approved()
+        end = int(p.transition['start']+p.transition['length'])+1
+        self.step(p, 2., index=end, y=5.)
+        self.assertIsNotNone(p.transition)
+        self.step(p, 2.1, index=end+1, y=3.6)
+        self.assertIsNone(p.transition)
+        self.assertEqual(p.current_lane, 2)
+
+    def test_approved_path_reaches_target_without_reverse_or_new_target(self):
+        p = self.approved()
+        ego = (60., 7.2)
+        target = p.transition['target']
+        finished = False
+        for step in range(100):
+            d = p.plan(int(ego[0]), ego, 15., [], desired_speed_mps=f.CRUISE,
+                       observation_stamp=1.5+step*.1)
+            if p.transition is None:
+                finished = True
+                self.assertEqual(p.current_lane, target)
+                self.assertLessEqual(abs(ego[1]-f.LANE_Y[target]), .35)
+                break
+            self.assertEqual(p.transition['target'], target)
+            self.assertNotEqual(d.state, 'CANCELLING')
+            ego = f.point_at(d.path, 1.5)
+        self.assertTrue(finished)
+
+    def test_geometry_dropout_keeps_target_and_cached_path(self):
+        p = self.approved()
+        original = dict(p.transition)
+        p.lane_indices[2].pop(60)
+        d = self.step(p, 1.5)
+        self.assertEqual(p.transition, original)
+        self.assertTrue(d.path)
+
+    def test_other_highway_sector_does_not_use_commit_policy(self):
+        p = planner(r3_end=180)
+        p.sectors = [10]*len(p.sectors)
+        p.highway_sectors = (10,)
+        self.step(p, 1.)
+        self.assertIsNotNone(p.transition)
+        self.assertNotIn('committed', p.transition)
+
+
+if __name__ == '__main__':
+    unittest.main()
