+    def exit_return(self, planner, decision, points, pose, speed):
+        """Commit to a body-checked R1 return before the saved R2 ends."""
+        s = planner.last_s
+        if self.exit_profile is None and s < planner.static_pass_zone[2]-12.:
+            return None
+        if self.exit_profile is None:
+            lo, hi = planner.route.window(s-2., s+3.)
+            _, d, seg = planner.route.project(pose[0], pose[1], lo, hi)
+            tangent = planner.route.tangents[seg]
+            error = math.atan2(math.sin(pose[2]-math.atan2(tangent[1], tangent[0])),
+                               math.cos(pose[2]-math.atan2(tangent[1], tangent[0])))
+            if abs(d) < .25 or abs(error) > math.radians(35.):
+                return None
+            # Search a gradual return, not a short bridge to a path already
+            # near R1. Actual obstacles and curvature still veto each choice.
+            for length in (12., 16., 20.):
+                end = min(s+length, planner.static_pass_zone[3]+8., planner.route.s[-1])
+                if end-s < 4.:
+                    continue
+                candidate = Profile([s, end], [d, 0.], [math.tan(error), 0.])
+                if self.safe(planner, candidate, decision.obstacles, speed, points, pose):
+                    self.exit_profile = candidate
+                    self.mode = 'recover'
+                    break
+        if self.exit_profile is None:
+            return None
+        return self.follow_prefix(planner, decision, self.exit_profile, points, pose,
+                                  speed, 'RECOVERY')
