+import unittest
+from pathlib import Path
+from unittest.mock import MagicMock,patch
+import xml.etree.ElementTree as ET
+import test_s11_min30 as fixture
+import test_s11_entry_slowdown as entry
+from pedal_guard import CruiseBrake
+
+
+class EntryBrakeTests(unittest.TestCase):
+    def follower(self):
+        n=fixture.S11Min30Tests().follower()
+        node=ET.parse(Path(__file__).resolve().parents[2]/'unita_launch/launch/semi.launch').find("node[@name='gps_waypoint_follower']")
+        def param(name):return float(node.find("param[@name='%s']"%name).get('value'))
+        n.sector11_entry_brake=CruiseBrake(gain=param('sector11_entry_brake_gain'),
+            max_brake=param('sector11_entry_max_brake'),rise_rate=param('sector11_entry_brake_rise_rate'))
+        n.lane_change_reason='s11_entry_slowdown'
+        return n
+
+    def test_entry_reaches_85_percent_within_point3_seconds_even_with_pid_accel(self):
+        n=self.follower();n.current_speed_kmh=83.
+        n.speed_pid.update=MagicMock(return_value=1.)
+        for i in range(6):
+            with patch('gps_waypoint_follower.time.monotonic',return_value=10.+i*.05):n.publish_control(0.,30.)
+            cmd=n.ctrl_pub.publish.call_args.args[0]
+            self.assertAlmostEqual(cmd.brake,min(.85,.15*(i+1)))
+            self.assertEqual(cmd.accel,0.)
+
+    def test_braking_tapers_and_releases_at_31(self):
+        n=self.follower();n.sector11_entry_brake.brake=.85
+        n.speed_pid.update=MagicMock(return_value=-1.)
+        for speed,brake in ((40.,.72),(35.,.32),(32.,.08),(31.,0.),(30.,0.),(29.,0.)):
+            n.current_speed_kmh=speed;n.publish_control(0.,0.)
+            self.assertAlmostEqual(n.ctrl_pub.publish.call_args.args[0].brake,brake)
+            self.assertEqual(n.requested_target_speed_kmh,30.)
+
+    def test_entry_brake_does_not_leak_into_normal_s11_or_other_sector(self):
+        for reason,sector in (('s11_forward_only',11),('s11_entry_slowdown',10)):
+            n=self.follower();n.sector11_entry_brake.brake=.85
+            n.lane_change_reason=reason;n.route_sectors=[sector]
+            n.speed_pid.update=MagicMock(return_value=0.)
+            n.publish_control(0.,60.)
+            self.assertEqual(n.sector11_entry_brake.brake,0.)
+            self.assertEqual(n.ctrl_pub.publish.call_args.args[0].brake,0.)
+
+    def test_bag_r2_edge_detection_triggers_before_entry(self):
+        p=entry.planner()
+        o=entry.npc(lane_stable=True,lane_sector=11,raceline=2,lane_boundary_crossing=False)
+        o.x,o.y=67.,144.4
+        d=p.plan(44,entry.point(-16.),77.54/3.6,[o],desired_speed_mps=100./3.6)
+        self.assertEqual(d.reason,'s11_entry_slowdown')
+        self.assertEqual(d.speed_cap_kmh,30.)
+        self.assertIsNone(p.transition)
+
+    def test_latch_extends_past_old_release_point(self):
+        p=entry.planner()
+        p.plan(60,entry.point(0.),20.,[entry.npc()],desired_speed_mps=25.)
+        d=p.plan(103,entry.point(43.),10.,[],desired_speed_mps=25.)
+        self.assertEqual(d.reason,'s11_entry_slowdown')
+        self.assertEqual(d.speed_cap_kmh,30.)
+
+
+if __name__=='__main__':unittest.main()
