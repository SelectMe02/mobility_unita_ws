<launch>
  <!-- Empty overrides use the common YAML defaults. -->
  <arg name="raceline_config" default="$(find unita_waypoint)/config/raceline_layout.yaml"/>
  <arg name="raceline_width" default=""/>
  <arg name="start_rviz" default="true"/>
  <arg name="project_file" default="/home/unita/unita_ws/src/unita_waypoint/config/map_tunner_project.json"/>
  <arg name="waypoint_file" default="$(find unita_waypoint)/config/waypoints.csv"/>
  <arg name="checkpoint_file" default="$(find unita_waypoint)/config/map_tunner_checkpoints.yaml"/>
  <arg name="image_file" default="$(find unita_waypoint)/config/kcity_map_sim.png"/>
  <arg name="calibration_file" default="$(find unita_waypoint)/config/map_tunner_calibration.yaml"/>
  <arg name="pose_topic" default="/localization/pose"/>
  <arg name="valid_topic" default="/localization/valid"/>
  <arg name="speed_topic" default="/competition/ego_speed_kmh"/>
  <arg name="obstacles_topic" default="/waypoint_debug/obstacles"/>
  <!-- Actual S4 steering source, safe prefix distance and stop reason. -->
  <arg name="route_avoidance_topic" default="/leo/route_avoidance"/>
  <!-- User supplied body dimensions, with the rear axle as the pose origin. -->
  <arg name="vehicle_front_m" default="3.845"/>
  <arg name="vehicle_rear_m" default="0.790"/>
  <arg name="vehicle_half_width_m" default="0.946"/>
  <arg name="vehicle_height_m" default="2.434"/>
  <node pkg="unita_waypoint" type="map_debug.py" name="map_debug" output="screen">
    <param name="raceline_config" value="$(arg raceline_config)"/>
    <param if="$(eval arg('raceline_width') != '')" name="raceline_width" value="$(arg raceline_width)" type="double"/>
    <param name="project_file" value="/home/unita/unita_ws/src/unita_waypoint/config/map_tunner_project.json"/>
    <param name="waypoint_file" value="$(arg waypoint_file)"/>
    <param name="checkpoint_file" value="$(arg checkpoint_file)"/>
    <param name="image_file" value="$(arg image_file)"/>
    <param name="calibration_file" value="$(arg calibration_file)"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="valid_topic" value="$(arg valid_topic)"/>
    <param name="speed_topic" value="$(arg speed_topic)"/>
    <param name="obstacles_topic" value="$(arg obstacles_topic)"/>
    <param name="route_avoidance_topic" value="$(arg route_avoidance_topic)"/>
    <param name="vehicle_front_m" value="$(arg vehicle_front_m)"/>
    <param name="vehicle_rear_m" value="$(arg vehicle_rear_m)"/>
    <param name="vehicle_half_width_m" value="$(arg vehicle_half_width_m)"/>
    <param name="vehicle_height_m" value="$(arg vehicle_height_m)" type="str"/>
  </node>
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="map_debug_rviz"
        args="-d $(find unita_waypoint)/config/map_debug.rviz" output="screen">
    <env name="DISABLE_ROS1_EOL_WARNINGS" value="1"/>
  </node>
</launch>
