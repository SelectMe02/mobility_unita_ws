+
+    def test_path_obstacle_still_stops_predicted_entry(self):
+        p = core.LocalAvoidancePlanner([(float(x), 0.) for x in range(101)], [9]*101, {},
+            roundabout_conflict_point=(30., 0.),
+            roundabout_approach_points=[(30., 30.), (30., 0.), (45., 0.)])
+        p.s9_prediction = model()
+        p.s9_prediction.active = True
+        p.roundabout_yield_seen = True
+        decision = p.plan(10, (10., 0.), 0., [core.Obstacle(13., 0., 1.)],
+                          desired_speed_mps=5., observation_stamp=10.6)
+        self.assertEqual(decision.speed_cap_kmh, 0.)
+
+    def test_leaving_s9_discards_prediction_history(self):
+        p = core.LocalAvoidancePlanner([(float(x), 0.) for x in range(101)], [8]*101, {},
+            roundabout_conflict_point=(30., 0.),
+            roundabout_approach_points=[(30., 30.), (30., 0.), (45., 0.)])
+        p.s9_prediction = model()
+        p.s9_prediction.active = True
+        p.plan(10, (10., 0.), 0., [], desired_speed_mps=5., observation_stamp=10.7)
+        self.assertFalse(p.s9_prediction.tracks)
+        self.assertFalse(p.s9_prediction.active)
+
+    def test_pedal_release_is_scoped_to_sector9(self):
+        from gps_waypoint_follower import GPSWaypointFollower
+        from pedal_guard import PedalGuard
+        for sector in (8, 9, 10):
+            n = GPSWaypointFollower.__new__(GPSWaypointFollower)
+            n.longitudinal_control_mode, n.control_rate = 'pid', 20.
+            n.last_pid_update, n.current_speed_kmh = 1., 0.
+            n.speed_pid = MagicMock()
+            n.speed_pid.update.return_value = 1.
+            n.ctrl_pub, n.sector11_cruise_brake = MagicMock(), None
+            n.lane_change_reason = 's9_predicted_entry'
+            n.local_planner = SimpleNamespace(clear_hold_s=.4, restart_accel_rate=.5)
+            n.route_sectors, n.current_waypoint_index = [sector], 0
+            n.pedal_guard = PedalGuard()
+            n.pedal_guard.stop(1.)
+            with patch('gps_waypoint_follower.time.monotonic', return_value=1.1):
+                n.publish_control(0., 5.)
+            cmd = n.ctrl_pub.publish.call_args.args[0]
+            self.assertEqual(cmd.brake, 0. if sector == 9 else 1.)
+
+
+if __name__ == '__main__':
+    unittest.main()
