+"""S9 entry timing, uncertain traffic and strict sector-isolation regressions."""
+import importlib.util
+import math
+from pathlib import Path
+import sys
+import unittest
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+ROOT = Path(__file__).resolve().parents[3]
+SCRIPTS = ROOT / 'src/unita_waypoint/scripts'
+sys.path.insert(0, str(SCRIPTS))
+import local_avoidance_core as core
+
+
+def model(speed=5.):
+    p = core.S9RoundaboutPrediction()
+    for i in range(7):
+        p.update(10.+i*.1, [(10.+speed*i*.1, 2.3, True)])
+    return p
+
+
+class S9PredictionTests(unittest.TestCase):
+    def test_speed_comes_from_observed_arc_displacement(self):
+        for speed in (3., 5., 7.):
+            p = model(speed)
+            self.assertTrue(p.tracks[0]['reliable'])
+            self.assertAlmostEqual(p.tracks[0]['v'], speed)
+
+    def test_repeat_scan_does_not_confirm_velocity(self):
+        p = core.S9RoundaboutPrediction()
+        for _ in range(10):
+            p.update(1., [(10., 2.3, True)])
+        self.assertFalse(p.tracks[0]['reliable'])
+        self.assertEqual(len(p.tracks[0]['history']), 1)
+
+    def test_predict_before_measured_rear_clears(self):
+        p = model()
+        self.assertLess(p.tracks[0]['s']-2.3, 20.+3.5)
+        cap = p.window(20., 3.5, 8., 0., 8., 4.635)
+        self.assertIsNotNone(cap)
+        self.assertGreater(cap, 0.)
+        self.assertLessEqual(cap, 10.)
+        end = p.debug['occupancy'][0][1]
+        self.assertGreaterEqual(p.debug['ego_entry_s'], end+.5)
+
+    def test_close_following_vehicle_blocks_full_ego_occupancy(self):
+        p = core.S9RoundaboutPrediction()
+        for i in range(7):
+            p.update(10.+i*.1, [(10.+5.*i*.1, 2.3, True),
+                                (-3.+5.*i*.1, 2.3, True)])
+        self.assertIsNone(p.window(20., 3.5, 8., 0., 8., 4.635))
+
+    def test_stopped_and_uncertain_obstacles_do_not_grant_departure(self):
+        for speed in (0., .2):
+            p = model(speed)
+            self.assertIsNone(p.window(20., 3.5, 8., 0., 8., 4.635))
+
+    def test_dropout_holds_and_reassociation_uses_observed_speed(self):
+        p = model()
+        p.update(11.1, [])
+        self.assertIsNone(p.window(20., 3.5, 8., 0., 8., 4.635))
+        p.update(11.2, [(16., 2.3, True)])
+        self.assertEqual(len(p.tracks), 1)
+        self.assertAlmostEqual(p.tracks[0]['v'], 5.)
+        self.assertIsNotNone(p.window(20., 3.5, 8., 0., 8., 4.635))
+
+    def test_speed_change_cancels_constant_speed_prediction(self):
+        p = model()
+        for i in range(1, 13):
+            p.update(10.6+i*.1, [(13., 2.3, True)])
+        self.assertIsNone(p.window(20., 3.5, 8., 0., 8., 4.635))
+
+    def test_fast_ego_cannot_assume_instant_braking(self):
+        p = model()
+        self.assertIsNone(p.window(20., 3.5, 4., 8., 8., 4.635))
+
+    def test_missing_timestamp_and_time_reset(self):
+        p = model()
+        self.assertFalse(p.update(None, []))
+        p.update(1., [(10., 2.3, True)])
+        self.assertFalse(p.tracks[0]['reliable'])
+
+    def test_observation_loss_does_not_retire_vehicle(self):
+        p = model()
+        p.update(20., [])
+        self.assertIsNone(p.window(20., 3.5, 8., 0., 8., 4.635))
+        self.assertEqual(len(p.tracks), 1)
+
+    def test_measured_clear_rear_returns_to_normal_speed(self):
+        p = model()
+        self.assertEqual(p.window(0., 3.5, 8., 0., 8., 4.635), 28.8)
+        self.assertFalse(p.tracks)
+
+    def test_other_sectors_match_prechange_planner(self):
+        path = ROOT / 'rollback/2026-10-28_s9_predictive_entry_before/src/unita_waypoint/scripts/local_avoidance_core.py'
+        spec = importlib.util.spec_from_file_location('s9_before', path)
+        before = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = before
+        spec.loader.exec_module(before)
+        route = [(float(x), 0.) for x in range(101)]
+        for sector in range(1, 15):
+            if sector == 9:
+                continue
+            planners = [m.LocalAvoidancePlanner(route, [sector]*len(route), {},
+                roundabout_conflict_point=(30., 0.),
+                roundabout_approach_points=[(30., 30.), (30., 0.), (45., 0.)])
+                for m in (before, core)]
+            for i in range(8):
+                decisions = []
+                for m, p in zip((before, core), planners):
+                    obstacles = [] if i % 2 else [m.Obstacle(20., 0., 1.)]
+                    decisions.append(p.plan(10, (10., 0.), 2., obstacles,
+                                            desired_speed_mps=5., observation_stamp=10.+i*.1))
+                self.assertEqual(vars(decisions[0]), vars(decisions[1]), sector)
+            self.assertFalse(planners[1].s9_prediction.tracks)
+
+    def test_s9_outside_monitor_does_not_start_predictor(self):
