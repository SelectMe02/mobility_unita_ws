+    def _candidate_translation(a, b):
+        """Lateral translation supported by both faces, not box growth.
+
+        Samples are (time, s, d, half_length, half_width). Unknown motion
+        is distinct from a measured stationary object.
+        """
+        dt = b[0]-a[0]
