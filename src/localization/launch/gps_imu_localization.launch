<launch>
  <arg name="config" default="$(find localization)/config/gps_imu.yaml"/>
  <!-- Enable only when this node owns map -> base_link. -->
  <arg name="publish_tf" default="false"/>
  <node pkg="localization" type="gps_imu_localization.py"
        name="gps_imu_localization" output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="publish_tf" value="$(arg publish_tf)"/>
  </node>
</launch>
