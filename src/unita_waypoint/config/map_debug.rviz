Panels:
- Class: unita_waypoint/MapDebugPanel
  Name: K-City 주행 상태
Visualization Manager:
  Class: ''
  Enabled: true
  Name: root
  Global Options:
    Fixed Frame: map
    Background Color: 28; 28; 28
    Frame Rate: 30
  Displays:
  - Class: rviz/Map
    Name: K-City 사진 대체 표시
    Enabled: false
    Topic: /map_debug/map
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
  - Class: rviz/Marker
    Name: K-City 컬러 배경사진
    Enabled: true
    Marker Topic: /map_debug/photo
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: 전체 경로와 Sector Checkpoint
    Enabled: true
    Marker Topic: /map_debug/markers
    Queue Size: 10
    Namespaces: {}
  - Class: rviz/MarkerArray
    Name: 현재 차량 위치와 Heading
    Enabled: true
    Marker Topic: /map_debug/vehicle
    Queue Size: 10
    Namespaces: {}
  - Class: rviz/Path
    Name: 장애물 회피 Local Path
    Enabled: true
    Topic: /waypoint_debug/local_path
    Color: 255; 80; 80
    Line Style: Lines
    Line Width: 0.15
  - Class: rviz/MarkerArray
    Name: 회피 판단 범위 (보라색 / 경로 거리)
    Enabled: true
    Marker Topic: /map_debug/obstacle_horizon
    Queue Size: 10
    Namespaces: {}
  - Class: rviz/MarkerArray
    Name: 인지 장애물 Box (동적 빨강 / 정적 파랑 / 분류 중 노랑)
    Enabled: true
    Marker Topic: /map_debug/obstacles
    Queue Size: 10
    Namespaces: {}
  - Class: rviz/PointCloud2
    Name: 제거한 노면 점 (초록 / 지도에 투영)
    Enabled: true
    Topic: /map_debug/ground_points
    Queue Size: 1
    Style: Points
    Size (Pixels): 2
    Color Transformer: FlatColor
    Color: 60; 220; 90
    Position Transformer: XYZ
    Decay Time: 0.35
  - Class: rviz/PointCloud2
    Name: 남긴 장애물 후보 점 (주황)
    Enabled: true
    Topic: /waypoint_debug/obstacle_points
    Queue Size: 1
    Style: Points
    Size (Pixels): 3
    Color Transformer: FlatColor
    Color: 255; 140; 40
    Position Transformer: XYZ
    Decay Time: 0.35
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top view
      Target Frame: <Fixed Frame>
      Scale: 1.0
      Angle: -1.570796327
      X: -42
      Y: -102
      Near Clip Distance: 0.01
    Saved: []
Window Geometry:
  Width: 1600
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
