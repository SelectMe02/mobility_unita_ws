Panels:
- Class: unita_waypoint/MapDebugPanel
  Name: 설정 · 라이다 · 카메라
Visualization Manager:
  Class: ''
  Enabled: true
  Name: root
  Global Options:
    Fixed Frame: map
    Background Color: 28; 28; 28
    Frame Rate: 30
  Displays:
  - Class: rviz/Map
    Name: K-City 사진 대체 표시
    Enabled: false
    Topic: /map_debug/map
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
  - Class: rviz/Marker
    Name: K-City 컬러 배경사진
    Enabled: true
    Marker Topic: /map_debug/photo
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: 전체 경로와 Sector Checkpoint
    Enabled: true
    Marker Topic: /map_debug/markers
    Queue Size: 10
    Namespaces: {}
  - Class: rviz/MarkerArray
    Name: 현재 차량 위치와 Heading
    Enabled: true
    Marker Topic: /map_debug/vehicle
    Queue Size: 10
    Namespaces: {}
  - Class: rviz/Marker
    Name: 장애물 회피 Local Path
    Enabled: true
    Marker Topic: /map_debug/map_local_path_markers
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: 인지 장애물 Box (동적 빨강 / 정적 파랑 / 분류 중 노랑)
    Enabled: true
    Marker Topic: /map_debug/obstacles
    Queue Size: 10
    Namespaces: {}
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top view
      Target Frame: <Fixed Frame>
      Scale: 1.0
      Angle: -1.570796327
      X: -42
      Y: -102
      Near Clip Distance: 0.01
    Saved: []
Window Geometry:
  Width: 1920
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
