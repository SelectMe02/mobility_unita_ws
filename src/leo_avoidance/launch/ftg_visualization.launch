<launch>
  <!-- Run alongside signal_tracking_avoidance_local.launch or signal_tracking_local.launch;
       no control topic is published. -->
  <arg name="start_rviz" default="true"/>
  <arg name="visualization_hz" default="5.0"/>
  <!-- Route avoidance plan (signal_tracking_local.launch enable_route_avoidance:=true):
       same route and pose as leo_route_avoidance. -->
  <arg name="waypoint_file" default="$(find unita_waypoint)/config/map_tunner_project.json"/>
  <arg name="pose_topic" default="/localization/pose"/>
  <node pkg="leo_avoidance" type="ftg_visualization_node.py"
        name="leo_ftg_visualization" output="screen">
    <rosparam command="load" file="$(find leo_avoidance)/config/avoidance_local.yaml"/>
    <param name="visualization_hz" value="$(arg visualization_hz)"/>
    <param name="waypoint_file" value="$(arg waypoint_file)"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
  </node>
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="leo_ftg_rviz"
        args="-d $(find leo_avoidance)/config/ftg_visualization.rviz"/>
</launch>
